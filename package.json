  "license": "MIT",
  "dependencies": {
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "prettier": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ConcaXu/ecommerce-price-monitor.git"
  },
  "bugs": {
