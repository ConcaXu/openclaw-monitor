{
  "name": "ecommerce-price-monitor",
  "version": "1.0.0",
  "description": "🦞 电商价格监控工具 - 自动监控淘宝、京东、拼多多商品价格变化，发送降价提醒，帮助用户抓住最佳购买时机",
  "main": "monitor.js",
  "bin": {
    "ecommerce-price-monitor": "./cli/index.js"
  },
  "scripts": {
    "start": "node monitor.js start",
    "dev": "node monitor.js check",
    "test": "node test-basic.js",
    "lint": "eslint . --ext .js",
    "format": "prettier --write .",
    "add": "node monitor.js add",
    "list": "node monitor.js list",
    "check": "node monitor.js check",
    "report": "node monitor.js report",
    "demo": "open demo.html || xdg-open demo.html || echo '请手动打开 demo.html'"
  },
  "keywords": [
    "ecommerce",
    "price-monitor",
    "taobao",
    "jd",
    "pdd",
    "openclaw",
    "skill",
    "shopping",
    "discount",
    "automation",
    "china"
  ],
